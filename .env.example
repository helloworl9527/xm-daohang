# Business dates and daily limits use this IANA timezone.
APP_TIMEZONE=Asia/Shanghai

# PostgreSQL connection used by the app, worker, migrations, and maintenance scripts.
DATABASE_URL=postgresql://app:replace-me@postgres:5432/collection_system

# At least 32 random bytes; used only to HMAC login IPs before database storage.
LOGIN_IP_HASH_KEY=replace-with-at-least-32-random-bytes
