# Business dates and daily limits use this IANA timezone.
APP_TIMEZONE=Asia/Shanghai

# PostgreSQL connection used by the app, worker, migrations, and maintenance scripts.
DATABASE_URL=postgresql://app:replace-me@postgres:5432/collection_system

# At least 32 random bytes; used only to HMAC login IPs before database storage.
LOGIN_IP_HASH_KEY=replace-with-at-least-32-random-bytes

# Independent key for per-day HMAC of public visitor IPs; never store the raw IP.
IP_HASH_KEY=replace-with-at-least-32-random-bytes

# High-entropy secret shared only by Caddy and the app to authenticate the client-IP header.
PROXY_SHARED_SECRET=replace-with-a-high-entropy-shared-secret

# Base64-encoded 32-byte AES-256-GCM key for encrypted application secrets.
APP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
