{
  "name": "collection-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/verify-production-artifact.mjs --prune .next/standalone",
    "db:migrate:prod": "node --experimental-strip-types scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "e2e": "playwright test",
    "start": "mkdir -p .next/standalone/.next && cp -R .next/static .next/standalone/.next/ && node .next/standalone/server.js",
    "lint": "eslint .",
    "init-admin": "node --experimental-strip-types scripts/init-admin.ts",
    "reset-admin-password": "node --experimental-strip-types scripts/reset-admin-password.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "argon2": "0.44.0",
    "drizzle-orm": "0.45.2",
    "grammy": "1.38.3",
    "ipaddr.js": "2.5.0",
    "jsdom": "26.1.0",
    "lucide-react": "1.31.0",
    "next": "15.5.23",
    "next-intl": "4.13.5",
    "openai": "7.4.0",
    "pdfjs-dist": "4.10.38",
    "pg": "8.22.0",
    "pg-boss": "10.3.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "undici": "6.28.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.3.0",
    "@types/pg": "8.21.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.23",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
